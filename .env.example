# Database (Railway PostgreSQL with pgvector)
DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-..."

# GitHub Token (read-only, for auto-sync of saved replies + catalog)
GITHUB_TOKEN="github_pat_..."

# wwbun Integration
WWBUN_API_URL="https://your-wwbun-app.railway.app"

# Shared secret between digital-ketu2 and wwbun (server-to-server auth)
# Set the SAME value on both services. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DIGITAL_KETU_SECRET=""

# Server
PORT=3000
NODE_ENV=production

# Audio Transcription (optional — unlocks WhatsApp voice notes for AI replies + learning)
# Pick ONE provider and add its key. If no key is set, audio falls back to the media_only
# auto-reply ("Sir, please type your query").
#   groq   — Whisper-v3-turbo, ~$0.0007/min, ~500ms, decent Hindi (~80% accuracy)
#   openai — Whisper-1,        ~$0.006/min,  ~3s,    decent Hindi (~80% accuracy)
#   sarvam — Hindi-first API,  ~₹0.30/min,   ~2s,    best Hindi/Hinglish (~92% accuracy)
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=

# GitHub Repos (for sync)
GITHUB_REPO_WWBUN="thakyanamtumhara/wwbun"
GITHUB_REPO_CATALOG="thakyanamtumhara/catalog"
