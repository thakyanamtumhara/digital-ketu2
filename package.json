{
  "name": "digital-ketu2",
  "version": "1.0.0",
  "description": "AI Auto-Reply Server for WhatsApp — processes messages via RAG + Claude API",
  "scripts": {
    "dev": "bun run --watch server/index.js",
    "start": "bun run server/index.js",
    "build": "bun run vite build",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:migrate": "bunx prisma migrate deploy",
    "sync": "bun run server/sync.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.13.0",
    "@prisma/client": "^6.5.0",
    "hono": "^4.7.0",
    "pgvector": "^0.2.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
